# Copy this file to ".env" and fill in the real values. Never commit ".env".
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.8-flash
# Optional: used when the main model is busy. Check the exact name in AI Studio.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001

# Spring must send this value in the X-Internal-Key header.
# Use a long random string. For local development any value is fine.
INTERNAL_API_KEY=change-me-dev-key
